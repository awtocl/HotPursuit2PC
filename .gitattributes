* text=auto

# Data the tools parse: keep byte-stable line ends on every platform.
*.tsv  text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Windows-only scripts and resources.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.rc   text eol=crlf
*.manifest text eol=crlf

*.ico binary
*.png binary
